{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "polyglot.lesson/v2",
  "title": "Polyglot Studio lesson (v2)",
  "description": "One lesson. Markdown fields: summary, sections[].md, item.prompt/explain/hint/options[]/model/rubric[], errors[].feedback, production.prompt/model/rubric[], cards[].front/back. See studio/README.md for the Markdown subset.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "track",
    "id",
    "roadmap",
    "kind",
    "title",
    "subtitle",
    "level",
    "minutes",
    "summary",
    "objectives",
    "sections",
    "practice",
    "mastery",
    "production",
    "cards",
    "meta"
  ],
  "properties": {
    "schema": {
      "const": "polyglot.lesson/v2"
    },
    "track": {
      "enum": [
        "greek",
        "french",
        "solidity",
        "ai",
        "automation",
        "jev"
      ]
    },
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "roadmap": {
      "type": "string",
      "description": "Roadmap topic id this lesson covers (content/syllabus/<track>.json)."
    },
    "kind": {
      "enum": [
        "core",
        "consolidation",
        "project"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 4,
      "maxLength": 110
    },
    "subtitle": {
      "type": "string",
      "maxLength": 220
    },
    "level": {
      "type": "string",
      "description": "CEFR (A1…C2) for languages; beginner/intermediate/advanced for technical tracks."
    },
    "minutes": {
      "type": "integer",
      "minimum": 10,
      "maximum": 90
    },
    "summary": {
      "type": "string",
      "description": "1–3 sentences (markdown): why this matters."
    },
    "objectives": {
      "type": "array",
      "minItems": 3,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,40}$"
          },
          "text": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(greek|french|solidity|ai|automation|jev):[0-9]+$"
      }
    },
    "vocab": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term",
          "meaning"
        ],
        "properties": {
          "term": {
            "type": "string"
          },
          "translit": {
            "type": "string"
          },
          "meaning": {
            "type": "string"
          },
          "alt": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "audio": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 3,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "md"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "title": {
            "type": "string"
          },
          "md": {
            "type": "string",
            "minLength": 200
          },
          "checks": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "$ref": "#/$defs/item"
            }
          }
        }
      }
    },
    "practice": {
      "type": "array",
      "minItems": 14,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "mastery": {
      "type": "array",
      "minItems": 16,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "production": {
      "$ref": "#/$defs/production"
    },
    "cards": {
      "type": "array",
      "minItems": 6,
      "items": {
        "$ref": "#/$defs/card"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "author",
        "created"
      ],
      "properties": {
        "author": {
          "type": "string"
        },
        "created": {
          "type": "string"
        },
        "adaptedFor": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "intro",
        "bands",
        "items"
      ],
      "properties": {
        "intro": {
          "type": "string"
        },
        "bands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2
        },
        "items": {
          "type": "array",
          "minItems": 8,
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      },
      "description": "Optional (lesson 1 of a track, or after a long break): a level test. Items carry 'band'; skill may be any kebab topic id."
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "skill",
        "level",
        "prompt",
        "explain"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "type": {
          "enum": [
            "mcq",
            "multi",
            "type",
            "cloze",
            "order",
            "match",
            "numeric",
            "dictation",
            "speak",
            "code",
            "handwrite",
            "explain",
            "jsexpr",
            "jscode"
          ]
        },
        "skill": {
          "type": "string",
          "description": "objective id (for daily drills: track:lesson/objective)"
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "description": "1 recognise · 2 recall/apply · 3 transfer"
        },
        "prompt": {
          "type": "string"
        },
        "explain": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "lang": {
          "enum": [
            "el",
            "fr",
            "nl",
            "en",
            "code",
            "num"
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "answer": {
          "type": "integer",
          "minimum": 0
        },
        "answers": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "integer"
            ]
          }
        },
        "text": {
          "type": "string"
        },
        "tiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "distractors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "alts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pairs": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "value": {
          "type": "number"
        },
        "tolerance": {
          "type": "number",
          "minimum": 0
        },
        "abs": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "translit": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "rubric": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "match",
              "feedback"
            ],
            "properties": {
              "match": {
                "type": "string"
              },
              "feedback": {
                "type": "string"
              },
              "tag": {
                "type": "string"
              }
            }
          }
        },
        "starter": {
          "type": "string"
        },
        "solution": {
          "type": "string"
        },
        "contract": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/test"
          }
        },
        "extraSources": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "accentsOptional": {
          "type": "boolean"
        },
        "typos": {
          "type": "boolean"
        },
        "caseSensitive": {
          "type": "boolean"
        },
        "long": {
          "type": "boolean"
        },
        "placeholder": {
          "type": "string"
        },
        "audio": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "description": "jsexpr/jscode: input items (JSON objects, without the {json:…} wrapper)"
        },
        "input": {
          "description": "jsexpr: the current item's JSON (shorthand for items:[input])"
        },
        "itemIndex": {
          "type": "integer",
          "minimum": 0
        },
        "nodes": {
          "type": "object",
          "description": "jsexpr/jscode: outputs of earlier nodes for $('Node Name') — {\"Node Name\": [ {…}, … ]}"
        },
        "expected": {
          "description": "jsexpr: expected value (any JSON). With perItem: array of per-item results"
        },
        "perItem": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "all",
            "each"
          ],
          "description": "jscode: Run Once for All Items | Each Item"
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "items",
              "expected"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "items": {
                "type": "array"
              },
              "nodes": {
                "type": "object"
              },
              "expected": {
                "type": "array"
              }
            }
          }
        },
        "unordered": {
          "type": "boolean"
        },
        "band": {
          "type": "string",
          "description": "diagnostic items only: difficulty band (A1…C2 or basis/gevorderd/expert)"
        },
        "deployArgs": {
          "type": "array"
        },
        "join": {
          "type": "string",
          "description": "order: string used to join tiles (default one space; use \"\" for letter tiles)"
        }
      }
    },
    "test": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "properties": {
            "contains": {
              "type": "string"
            },
            "notContains": {
              "type": "string"
            },
            "matches": {
              "type": "string"
            },
            "notMatches": {
              "type": "string"
            }
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "production": {
      "type": "object",
      "required": [
        "type",
        "prompt",
        "model"
      ],
      "properties": {
        "type": {
          "enum": [
            "write",
            "explain",
            "code",
            "jscode"
          ]
        },
        "prompt": {
          "type": "string"
        },
        "lang": {
          "enum": [
            "el",
            "fr",
            "nl",
            "en"
          ]
        },
        "minWords": {
          "type": "integer",
          "minimum": 0
        },
        "model": {
          "type": "string"
        },
        "rubric": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "starter": {
          "type": "string"
        },
        "solution": {
          "type": "string"
        },
        "contract": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/test"
          }
        },
        "extraSources": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "mode": {
          "enum": [
            "all",
            "each"
          ],
          "description": "jscode: Run Once for All Items | Each Item"
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "items",
              "expected"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "items": {
                "type": "array"
              },
              "nodes": {
                "type": "object"
              },
              "expected": {
                "type": "array"
              }
            }
          }
        },
        "unordered": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "description": "jsexpr/jscode: input items (JSON objects, without the {json:…} wrapper)"
        },
        "nodes": {
          "type": "object",
          "description": "jsexpr/jscode: outputs of earlier nodes for $('Node Name') — {\"Node Name\": [ {…}, … ]}"
        }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "front",
        "back"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "front": {
          "type": "string"
        },
        "back": {
          "type": "string"
        },
        "answers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "If present the card is typed recall (auto-graded); otherwise a flip card."
        },
        "lang": {
          "enum": [
            "el",
            "fr",
            "nl",
            "en",
            "code",
            "num"
          ]
        },
        "skill": {
          "type": "string"
        },
        "reverse": {
          "type": "object",
          "properties": {
            "answers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "lang": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}